{
  "name": "socal-transportation-view",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/materialize-road-data.mjs",
    "prebuild": "node scripts/materialize-road-data.mjs",
    "prepreview": "node scripts/materialize-road-data.mjs",
    "data:materialize": "node scripts/materialize-road-data.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "data:transit": "python3 scripts/import_gtfs.py && python3 scripts/import_transit_details.py",
    "data:boundaries": ".venv-data/bin/python scripts/import_boundaries.py",
    "data:roads": ".venv-data/bin/python scripts/import_roads.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "maplibre-gl": "6.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.0.0"
  },
  "description": "Inspired by Cities: Skylines II, an interactive atlas of Southern California’s roads, highways, and public transportation. Explore connected corridors, city boundaries, and layered transport networks in 2D and 3D."
}
